PUBLIC_GOOGLE_CLIENT_ID="your-google-client-id"

# Corporate login (independent from the optional Google Drive integration above).
# Production defaults to google and fails closed if configuration is incomplete.
# Development defaults to local. Set google explicitly to test corporate login.
VAULT_AUTH_MODE="google"
VAULT_AUTH_ORIGIN="http://127.0.0.1:4321"
GOOGLE_AUTH_CLIENT_ID=""
GOOGLE_AUTH_CLIENT_SECRET=""
AUTH_SECRET=""

# Exact values, comma-separated. The lists are combined with OR.
VAULT_ALLOWED_DOMAINS="latamware.com"
VAULT_ALLOWED_EMAILS=""
# Server-managed company storage. Use an absolute persistent path outside the repository.
VAULT_DATABASE_PATH=""
VAULT_ADMIN_EMAILS=""
VAULT_ACTIVE_KEY_ID="v1"
# JSON map of key IDs to independent cryptographically random 32-byte Base64 keys.
# Keep old keys when rotating; never use AUTH_SECRET as the encryption key.
VAULT_ENCRYPTION_KEYS='{}'
# Automatic audit seals are enabled by default in Google mode (five-minute batches).
# Set false only to deliberately use manual sealing.
VAULT_AUDIT_AUTO="true"
# Future example only (not enabled by default):
# VAULT_ALLOWED_DOMAINS="latamware.com,iguapp.tur.ar"
# VAULT_ALLOWED_EMAILS="dapris12@gmail.com"
